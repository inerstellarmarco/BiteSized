# Leave DATABASE_URL unset to use a local PGlite database in ./data/bitesized.
# For Neon or any Postgres host:
# DATABASE_URL=postgres://user:password@host/neondb?sslmode=require

# First profile (Eric, admin) is created when the database is empty.
SEED_ADMIN_PIN=family-admin

# Copy backups here so they are not only inside the database provider.
# BACKUP_EXTERNAL_DIR=/var/backups/bite-sized

# Set true behind HTTPS (Vercel does this via x-forwarded-proto automatically).
# COOKIE_SECURE=true

# Later phases. Server-side only. Never use NEXT_PUBLIC_ for these.
LLM_PROVIDER=gemini
LLM_BACKUP_PROVIDER=openai
LLM_DAILY_REGENERATE_CAP=100
# LLM_API_KEY=
# LLM_BACKUP_API_KEY=
