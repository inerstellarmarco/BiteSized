# Neon (or any Postgres). Required on Vercel. Leave unset locally to use PGlite.
# DATABASE_URL=postgres://user:password@host/neondb?sslmode=require

# First admin passphrase, used only when the database has no profiles.
SEED_ADMIN_PIN=family-admin

# true on HTTPS. Vercel sets x-forwarded-proto, so you can leave this unset there.
# COOKIE_SECURE=true

# Session cookies are random tokens stored hashed in Postgres. No shared session secret is required.

# Gemini. Server-side only. Never prefix these with NEXT_PUBLIC_.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_API_KEY=
# LLM_API_KEY=

# Backup provider. Used automatically when Gemini errors or is rate limited.
LLM_BACKUP_PROVIDER=openai
# LLM_BACKUP_API_KEY=
# LLM_BACKUP_MODEL=gpt-4.1-mini
# LLM_BACKUP_BASE_URL=https://api.openai.com/v1

# Default daily cap if the admin has not saved one in the app. The live value is in the database.
LLM_DAILY_REGENERATE_CAP=100

# Optional local folder for npm run backup. Production backups use GitHub Actions artifacts
# or BACKUP_WEBHOOK_URL, not this folder.
# BACKUP_EXTERNAL_DIR=/var/backups/bite-sized

# Protects /api/cron/backup. Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
# CRON_SECRET=

# Optional place to POST the zip from the Vercel cron route.
# BACKUP_WEBHOOK_URL=
